#!/bin/bash
# Print the `# Reporting` subsections of CLAUDE.md.global that carry a reminder
# marker in their heading: "(ALL user-facing text)" or "(ALL final reports)".
# Reads the file on stdin, writes the sections to stdout.
#
# Repo tooling, not an agent script: it exists so `githooks/pre-commit` can hash
# the authoritative rules and compare that hash against the one recorded in
# scripts/reporting-rules-condensed.md. Selection is by marker, not by heading
# name, so tagging a new section pulls it into the sync check automatically.
#
# The marker set below is part of the authoritative rule selection: widening it
# changes which rules the per-turn reminder carries. `githooks/pre-commit`
# therefore also fires when this file is staged.

set -eu

awk '
  # Top-level headings delimit the Reporting section.
  /^# / {
    in_reporting = ($0 == "# Reporting")
    in_block = 0
    next
  }
  !in_reporting { next }
  /^## / {
    in_block = ($0 ~ /\((ALL user-facing text|ALL final reports)\)/)
  }
  in_block { print }
'
